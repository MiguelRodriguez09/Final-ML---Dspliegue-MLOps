# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual Environments
venv/
env/
ENV/
Proyecto-venv/
.venv
*.venv

# Jupyter Notebooks (no necesarios en container)
.ipynb_checkpoints
*.ipynb_checkpoints
**/*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes
.github/

# Documentation (excepto necesarios)
*.md
!DOCKER_README.md
Directrices/
QUICKSTART.md
SUMMARY.md
README2.md
EVALUACION_CHECKLIST.md
DOCKER_GUIDE.md

# Tests
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/

# Build artifacts
*.log
*.pid
*.seed
*.coverage
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
temp/
tmp/

# Scripts de desarrollo (no necesarios en container)
set_up.bat
run_pipeline.bat
docker-start.sh
docker-start.bat

# Archivos Docker (no necesarios dentro del container)
Dockerfile*
docker-compose*.yml
.dockerignore
Makefile

# Reportes y gráficos (se regeneran o se montan como volumen)
*.png
*.jpg
*.pdf
confusion_matrices.png
model_comparison.png
roc_curves.png
drift_summary.png

# SonarQube
sonar-project.properties
.scannerwork/

# Node modules (si existen)
node_modules/
npm-debug.log*

# Backup files
backups/
*.backup

