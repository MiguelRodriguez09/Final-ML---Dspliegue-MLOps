# ============================================
# MLOps Pipeline - Environment Variables Template
# ============================================
# Copiar a .env y personalizar valores
# ============================================

# Flask Configuration
FLASK_ENV=production
FLASK_APP=mlops_pipeline/src/model_deploy.py
FLASK_DEBUG=0
PORT=5000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# Model Paths (dentro del container)
MODEL_PATH=/app/best_model.pkl
PREPROCESSOR_PATH=/app/preprocessor.pkl
MODEL_METADATA_PATH=/app/model_metadata.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Configuration
API_TITLE="MLOps Churn Prediction API"
API_VERSION=1.0
MAX_BATCH_SIZE=1000

# Performance
WORKERS=4
THREADS=2
TIMEOUT=60

# Security (cambiar en producción)
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=*

# Database (opcional - para futuras extensiones)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mlops
# DB_USER=mlops_user
# DB_PASSWORD=secure_password

# Monitoring (opcional)
# SENTRY_DSN=
# DATADOG_API_KEY=

# Feature Flags
ENABLE_MONITORING=true
ENABLE_DRIFT_DETECTION=true
ENABLE_LOGGING=true
