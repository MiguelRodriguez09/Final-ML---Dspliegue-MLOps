[MASTER]
# Archivos o directorios a ignorar
ignore=CVS,.git,__pycache__,.venv,venv,Proyecto-venv

# Usar múltiples procesos para acelerar Pylint
jobs=4

# Extensiones de Python
extension-pkg-whitelist=numpy,pandas,sklearn,scipy,matplotlib,seaborn

[MESSAGES CONTROL]
# Deshabilitar algunos warnings que son demasiado estrictos para ML/DS
disable=
    C0103,  # invalid-name (permitir nombres como X, y, df)
    C0114,  # missing-module-docstring (ya tenemos docstrings en funciones)
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0913,  # too-many-arguments (común en ML)
    R0914,  # too-many-locals (común en análisis de datos)
    W0212,  # protected-access (a veces necesario)
    W0611,  # unused-import (manejado por autopep8)
    W0613,  # unused-argument (común en callbacks)
    E1101,  # no-member (falsos positivos con pandas/numpy)
    C0411,  # wrong-import-order
    R0801,  # duplicate-code (común en pipelines similares)
    R0902,  # too-many-instance-attributes
    R0903,  # too-few-public-methods
    R0904,  # too-many-public-methods
    R0911,  # too-many-return-statements
    R0912,  # too-many-branches
    R0915,  # too-many-statements

[FORMAT]
# Máximo de caracteres por línea
max-line-length=100

# Número máximo de líneas en un módulo
max-module-lines=1000

# Indentación
indent-string='    '
indent-after-paren=4

[DESIGN]
# Máximo de argumentos en funciones
max-args=10

# Máximo de variables locales
max-locals=25

# Máximo de atributos en clase
max-attributes=15

# Máximo de branches en función
max-branches=20

# Complejidad ciclomática máxima
max-complexity=15

[BASIC]
# Convenciones de nombres
good-names=i,j,k,x,y,z,df,X,y,ax,fig,lr,cv,id,_

# Regex para nombres de variables
variable-rgx=[a-z_][a-z0-9_]{1,30}$

# Regex para nombres de constantes
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

[SIMILARITIES]
# Mínimo de líneas similares para considerarlo duplicado
min-similarity-lines=10

# Ignorar comentarios al comparar similitudes
ignore-comments=yes

# Ignorar docstrings al comparar similitudes
ignore-docstrings=yes

# Ignorar imports al comparar similitudes
ignore-imports=yes

[TYPECHECK]
# Lista de miembros que no deberían ser chequeados
ignored-modules=numpy,pandas,sklearn,scipy,matplotlib,seaborn,cv2,torch,tensorflow
ignored-classes=numpy,pandas,sklearn,scipy,matplotlib,seaborn

[IMPORTS]
# Permitir imports relativos
allow-any-import-level=yes

[EXCEPTIONS]
# Excepciones que no necesitan ser mencionadas en el docstring
overgeneral-exceptions=Exception
