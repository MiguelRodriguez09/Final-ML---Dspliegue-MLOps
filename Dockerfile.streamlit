# ============================================
# MLOps Pipeline - Dockerfile para Streamlit
# ============================================
# Dockerfile específico para el dashboard
# de monitoreo con Streamlit
# ============================================

FROM python:3.10-slim

# Metadata
LABEL maintainer="MiguelRodriguez09"
LABEL description="MLOps Pipeline - Streamlit Dashboard"
LABEL version="1.0"

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario no-root
RUN useradd -m -u 1000 streamlit && \
    mkdir -p /app && \
    chown -R streamlit:streamlit /app

WORKDIR /app

# Copiar requirements
COPY requirements.txt .

# Instalar dependencias
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código de la aplicación
COPY --chown=streamlit:streamlit mlops_pipeline/ mlops_pipeline/
COPY --chown=streamlit:streamlit drift_report.json model_metadata.json ./
COPY --chown=streamlit:streamlit train_data.csv test_data.csv ./

# Exponer puerto de Streamlit
EXPOSE 8501

# Variables de entorno
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Cambiar a usuario no-root
USER streamlit

# Comando de inicio
CMD ["streamlit", "run", "mlops_pipeline/src/streamlit_app.py"]
